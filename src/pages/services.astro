---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import Marquee from '../components/Marquee.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Sticker from '../components/Sticker.astro';
import { CONTACT } from '../consts';
import { SERVICES } from '../data/services';
---

<BaseLayout
  title="Une équipe de webmasters Rouennais prêts à vous aider dès demain !"
  description="Création de site internet, gestion quotidienne, SEO, SEA, maintenance technique et surveillance : découvrez l'ensemble des services de l'agence Webmark'up à Rouen."
>
  <PageHero
    eyebrow="Nos services"
    title="Des webmasters Rouennais prêts dès demain"
    highlight="Rouennais"
    lead="Création de site internet, gestion quotidienne, SEO, SEA, maintenance technique et surveillance. Un seul interlocuteur pour toute votre présence en ligne."
  />

  <!-- Intro + sommaire -->
  <section class="container-page py-20 sm:py-28">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="space-y-6 text-lg leading-relaxed text-ink-900/80 lg:col-span-7">
        <p class="font-display text-2xl leading-snug font-bold text-ink-950">
          Bienvenue chez Webmark'up, votre agence de webmarketing basée à {CONTACT.city} en {
            CONTACT.region
          }.
        </p>
        <p>
          Notre objectif est de vous aider à transformer votre site web en une machine à générer des
          leads automatique et auto-géré. Nous utilisons des stratégies de webmarketing avancées pour
          attirer les bons clients, les convertir en leads qualifiés et les fidéliser.
        </p>
        <p>
          Notre équipe expérimentée est là pour vous accompagner à chaque étape de votre projet, que
          ce soit pour la création d'un site vitrine, d'un site e-commerce ou pour améliorer votre
          présence en ligne avec des services de SEO et de SEA.
        </p>
        <p>
          N'hésitez pas à <a
            class="font-semibold text-violet-600 underline decoration-2 underline-offset-4 hover:text-violet-500"
            href="/nous-contacter/">nous contacter</a
          > pour discuter de votre projet ou pour demander un devis, nous serons ravis de vous aider à
          atteindre vos objectifs de croissance grâce à un site internet performant.
        </p>
      </div>

      <nav class="lg:col-span-5" aria-label="Sommaire des services">
        <div class="rounded-[2rem] border-3 border-ink-950 bg-white p-8 shadow-hard-violet">
          <p class="font-display text-sm font-extrabold tracking-widest text-violet-600 uppercase">
            Nos six services
          </p>
          <ul class="mt-6 divide-y divide-ink-950/10">
            {
              SERVICES.map((service, index) => (
                <li>
                  <a
                    class="group flex items-center gap-4 py-4 font-display text-xl font-bold tracking-tight text-ink-950 transition hover:text-violet-600"
                    href={`#${service.id}`}
                  >
                    <span class="text-violet-300 tabular-nums transition group-hover:text-violet-600">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    {service.title}
                    <Icon
                      name="arrow-right"
                      class="ml-auto size-5 text-violet-400 transition group-hover:translate-x-1 group-hover:text-violet-600"
                    />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>
    </div>
  </section>

  <Marquee />

  <!-- Détail des services -->
  <section class="container-page py-20 sm:py-28">
    <div class="space-y-8">
      {
        SERVICES.map((service, index) => (
          <article
            id={service.id}
            class:list={[
              'scroll-mt-28 rounded-[2rem] border-3 border-ink-950 p-9 sm:p-12',
              index % 3 === 0 && 'bg-violet-600 text-white',
              index % 3 === 1 && 'bg-white',
              index % 3 === 2 && 'bg-spring-300',
            ]}
          >
            <div class="grid gap-8 lg:grid-cols-12 lg:items-start">
              <div class="lg:col-span-4">
                <span
                  class:list={[
                    'font-display text-7xl font-extrabold tabular-nums sm:text-8xl',
                    index % 3 === 0 ? 'text-white/35' : 'text-ink-950/20',
                  ]}
                >
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h2
                  class:list={[
                    'mt-2 font-display text-3xl leading-tight font-extrabold sm:text-4xl',
                    index % 3 === 0 ? 'text-white' : 'text-ink-950',
                  ]}
                >
                  {service.title}
                </h2>
              </div>
              <p
                class:list={[
                  'text-lg leading-relaxed lg:col-span-8',
                  index % 3 === 0 ? 'text-violet-50/85' : 'text-ink-950/75',
                ]}
              >
                {service.description ?? service.summary}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Bloc visuel + relance -->
  <section class="container-page pb-24 sm:pb-32">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <Photo
          name="atelier"
          alt="Atelier de travail sur un projet web"
          class="aspect-16/10 rounded-[2rem] border-3 border-ink-950 shadow-hard"
        />
      </div>
      <div class="lg:col-span-5">
        <Sticker tone="violet">Un doute ?</Sticker>
        <h2
          class="mt-6 font-display text-[clamp(2rem,5vw,3.5rem)] leading-[0.95] font-extrabold text-balance text-ink-950"
        >
          Dites-nous ce que vous voulez faire
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-ink-900/75">
          On vous dit franchement si c'est jouable, ce que ça implique et combien de temps ça prend.
          Sans jargon.
        </p>
        <Button href="/nous-contacter/" class="mt-8">
          Demander un devis
          <Icon name="arrow-right" class="size-4 transition group-hover/btn:translate-x-1" />
        </Button>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
