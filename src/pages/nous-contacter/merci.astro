---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
---

<BaseLayout title="Message envoyé" description="Votre demande a bien été envoyée à Webmark'up." noindex>
  <PageHero
    eyebrow="Merci !"
    title="Votre demande est bien arrivée"
    highlight="bien arrivée"
    lead="Nous revenons vers vous sous 24h avec une première analyse de votre projet."
  />
  <section class="container-page py-20 sm:py-28">
    <div class="flex flex-wrap gap-4">
      <Button href="/" variant="primary" size="lg">
        Retour à l'accueil
        <Icon name="arrow-right" class="size-5 transition group-hover/btn:translate-x-1" />
      </Button>
      <Button href="/blog/" variant="ink" size="lg">Lire notre blog</Button>
    </div>
  </section>
</BaseLayout>
