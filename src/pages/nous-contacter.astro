---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Marquee from '../components/Marquee.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Sticker from '../components/Sticker.astro';
import { CONTACT } from '../consts';

const fieldClass =
  'mt-2 block w-full rounded-2xl border-3 border-ink-950 bg-white px-4 py-3.5 text-ink-950 transition placeholder:text-ink-900/35 focus:border-violet-600 focus:outline-none';
const labelClass = 'block font-display text-sm font-extrabold tracking-wide uppercase text-ink-950';
---

<BaseLayout
  title="Nous contacter"
  description="Etudions ensemble votre projet : contactez l'agence web Webmark'up à Rouen, nous vous répondons sous 24h."
>
  <PageHero
    eyebrow="Nous contacter"
    title="Etudions ensemble votre projet"
    highlight="ensemble"
    lead="Contactez-nous sans tarder, nous vous répondrons sous 24h !"
  />

  <section class="container-page py-20 sm:py-28">
    <div class="grid gap-14 lg:grid-cols-12">
      <!-- Formulaire -->
      <div class="lg:col-span-7">
        <div class="rounded-[2rem] border-3 border-ink-950 bg-white p-8 shadow-hard-violet sm:p-11">
          <h2 class="font-display text-3xl leading-tight font-extrabold text-ink-950 sm:text-4xl">
            Parlez-nous de votre projet
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-ink-900/70">
            Quelques lignes suffisent. On revient vers vous avec une première analyse, gratuite et
            sans engagement.
          </p>

          <form
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            action="/nous-contacter/merci/"
            class="mt-9 space-y-6"
          >
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden">
              <label>
                Ne pas remplir : <input name="bot-field" tabindex="-1" autocomplete="off" />
              </label>
            </p>

            <div class="grid gap-6 sm:grid-cols-2">
              <div>
                <label class={labelClass} for="name">Nom et prénom</label>
                <input class={fieldClass} type="text" id="name" name="name" required autocomplete="name" />
              </div>
              <div>
                <label class={labelClass} for="company">Entreprise</label>
                <input class={fieldClass} type="text" id="company" name="company" autocomplete="organization" />
              </div>
              <div>
                <label class={labelClass} for="email">E-mail</label>
                <input class={fieldClass} type="email" id="email" name="email" required autocomplete="email" />
              </div>
              <div>
                <label class={labelClass} for="phone">Téléphone</label>
                <input class={fieldClass} type="tel" id="phone" name="phone" autocomplete="tel" />
              </div>
            </div>

            <div>
              <label class={labelClass} for="message">Votre projet</label>
              <textarea class={fieldClass} id="message" name="message" rows="6" required></textarea>
            </div>

            <button
              type="submit"
              class="group/btn inline-flex items-center justify-center gap-2.5 rounded-full border-3 border-ink-950 bg-spring-400 px-8 py-4 font-display text-lg font-extrabold tracking-tight text-ink-950 transition hover:-translate-y-1 hover:shadow-hard active:translate-y-0"
            >
              Envoyer ma demande
              <Icon name="arrow-right" class="size-5 transition group-hover/btn:translate-x-1" />
            </button>

            <p class="text-sm text-ink-900/55">
              Les informations transmises servent uniquement à traiter votre demande. Voir notre <a
                class="underline underline-offset-2"
                href="/privacy-policy/">politique de confidentialité</a
              >.
            </p>
          </form>
        </div>
      </div>

      <!-- Coordonnées -->
      <aside class="lg:col-span-5">
        <Sticker tone="violet">Ou directement</Sticker>
        <ul class="mt-6 space-y-5">
          <li>
            <a
              href={CONTACT.phoneHref}
              class="flex items-center gap-5 rounded-3xl border-3 border-ink-950 bg-white px-7 py-6 transition hover:-translate-y-1 hover:shadow-hard"
            >
              <Icon name="phone" class="size-6 text-violet-600" />
              <span class="font-display text-2xl font-extrabold tracking-tight text-ink-950">
                {CONTACT.phone}
              </span>
            </a>
          </li>
          <li>
            <a
              href={CONTACT.emailHref}
              class="flex items-center gap-5 rounded-3xl border-3 border-ink-950 bg-white px-7 py-6 transition hover:-translate-y-1 hover:shadow-hard"
            >
              <Icon name="mail" class="size-6 text-violet-600" />
              <span class="font-display text-lg font-extrabold tracking-tight break-all text-ink-950">
                {CONTACT.email}
              </span>
            </a>
          </li>
        </ul>

        <div class="mt-8 rounded-3xl border-3 border-ink-950 bg-violet-600 p-8 text-white">
          <h2 class="font-display text-2xl font-extrabold">Basés à {CONTACT.city}</h2>
          <p class="mt-3 leading-relaxed text-violet-50/85">
            Agence web en {CONTACT.region}. Nous accompagnons des entreprises partout en France — sur
            place ou à distance, comme vous préférez.
          </p>
          <p class="mt-6 font-display text-lg font-extrabold text-spring-300">
            Réponse sous 24h, promis.
          </p>
        </div>

        <Photo
          name="echange"
          alt="Échange autour d'un projet devant un ordinateur portable"
          class="mt-8 aspect-4/3 rounded-3xl border-3 border-ink-950"
        />
      </aside>
    </div>
  </section>

  <Marquee />
</BaseLayout>
