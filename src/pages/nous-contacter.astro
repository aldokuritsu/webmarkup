---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import { CONTACT } from '../consts';

const fieldClass =
  'mt-2 block w-full rounded-xl border-0 bg-white px-4 py-3 text-ink-900 ring-1 ring-ink-900/12 transition placeholder:text-ink-800/40 focus:ring-2 focus:ring-brand-500';
const labelClass = 'block text-sm font-semibold text-ink-900';
---

<BaseLayout
  title="Nous contacter"
  description="Etudions ensemble votre projet : contactez l'agence web Webmark'up à Rouen, nous vous répondons sous 24h."
>
  <PageHero
    eyebrow="Nous contacter"
    title="Etudions ensemble votre projet"
    lead="Contactez-nous sans tarder, nous vous répondrons sous 24h !"
  />

  <section class="container-page py-16 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <h2 class="text-2xl font-bold tracking-tight text-ink-900">Parlez-nous de votre projet</h2>
        <p class="mt-3 text-ink-800/80">
          Décrivez-nous votre besoin en quelques lignes : nous revenons vers vous avec une première
          analyse, gratuite et sans engagement.
        </p>

        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/nous-contacter/merci/"
          class="mt-8 space-y-6"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>
              Ne pas remplir : <input name="bot-field" tabindex="-1" autocomplete="off" />
            </label>
          </p>

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label class={labelClass} for="name">Nom et prénom</label>
              <input class={fieldClass} type="text" id="name" name="name" required autocomplete="name" />
            </div>
            <div>
              <label class={labelClass} for="company">Entreprise</label>
              <input class={fieldClass} type="text" id="company" name="company" autocomplete="organization" />
            </div>
            <div>
              <label class={labelClass} for="email">E-mail</label>
              <input class={fieldClass} type="email" id="email" name="email" required autocomplete="email" />
            </div>
            <div>
              <label class={labelClass} for="phone">Téléphone</label>
              <input class={fieldClass} type="tel" id="phone" name="phone" autocomplete="tel" />
            </div>
          </div>

          <div>
            <label class={labelClass} for="message">Votre projet</label>
            <textarea class={fieldClass} id="message" name="message" rows="6" required></textarea>
          </div>

          <button
            type="submit"
            class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-500 px-7 py-3.5 font-semibold text-white shadow-sm shadow-brand-500/30 transition hover:bg-brand-600"
          >
            Envoyer ma demande
            <Icon name="arrow-right" class="size-4" />
          </button>

          <p class="text-xs text-ink-800/60">
            Les informations transmises servent uniquement à traiter votre demande. Voir notre <a
              class="underline underline-offset-2"
              href="/privacy-policy/">politique de confidentialité</a
            >.
          </p>
        </form>
      </div>

      <aside class="lg:col-span-2">
        <div class="rounded-2xl bg-brand-50/70 p-8 ring-1 ring-brand-500/15">
          <h2 class="text-lg font-semibold text-ink-900">Informations de contact</h2>
          <ul class="mt-6 space-y-4">
            <li>
              <a class="flex items-center gap-3 font-medium text-ink-900 transition hover:text-brand-600" href={CONTACT.phoneHref}>
                <Icon name="phone" class="size-5 text-brand-600" />
                {CONTACT.phone}
              </a>
            </li>
            <li>
              <a class="flex items-center gap-3 font-medium break-all text-ink-900 transition hover:text-brand-600" href={CONTACT.emailHref}>
                <Icon name="mail" class="size-5 text-brand-600" />
                {CONTACT.email}
              </a>
            </li>
          </ul>
          <p class="mt-6 text-sm leading-relaxed text-ink-800/80">
            Agence web basée à {CONTACT.city}, en {CONTACT.region}. Nous accompagnons des entreprises
            partout en France.
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
