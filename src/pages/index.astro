---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import { CONTACT, SITE_DESCRIPTION, SITE_TAGLINE, SITE_URL } from '../consts';
import { SERVICES } from '../data/services';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: "Webmark'up",
  description: SITE_DESCRIPTION,
  url: SITE_URL,
  telephone: '+33972191287',
  email: CONTACT.email,
  areaServed: 'France',
  address: {
    '@type': 'PostalAddress',
    addressLocality: CONTACT.city,
    addressRegion: CONTACT.region,
    addressCountry: CONTACT.country,
  },
  makesOffer: SERVICES.map((service) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: service.title, description: service.summary },
  })),
};
---

<BaseLayout title="Agence web à Rouen" description={SITE_DESCRIPTION}>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-linear-to-br from-ink-950 via-ink-900 to-brand-900">
    <div
      class="pointer-events-none absolute -top-32 -right-24 size-96 rounded-full bg-brand-500/20 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div class="container-page relative py-20 sm:py-28">
      <p class="text-sm font-semibold tracking-widest text-brand-400 uppercase">
        Webmark'up — Agence web à {CONTACT.city}
      </p>
      <h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-white text-balance sm:text-5xl lg:text-6xl">
        {SITE_TAGLINE}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">
        Chez Webmark'up, nous aidons les entreprises à transformer leur site internet en une machine
        à générer des leads automatique et auto-géré. Nous utilisons des stratégies de webmarketing
        avancées pour attirer les bons clients, les convertir en leads qualifiés et les fidéliser.
        Nous vous offrons également des outils pour automatiser et optimiser le processus de
        génération de leads, afin que vous puissiez vous concentrer sur ce qui est vraiment important
        : la croissance de votre entreprise.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <Button href="/a-propos/" variant="ghost" size="lg">Pourquoi nous choisir ?</Button>
        <Button href="/nous-contacter/" size="lg">Nous contacter</Button>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="container-page py-20 sm:py-24">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold tracking-tight text-ink-900 text-balance sm:text-4xl">
        Tout ce dont votre présence en ligne a besoin
      </h2>
      <p class="mt-4 text-lg text-ink-800/80">
        Six expertises complémentaires, de la conception de votre site à sa surveillance au
        quotidien.
      </p>
    </div>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        SERVICES.map((service) => (
          <li class="rounded-2xl bg-white p-7 ring-1 ring-ink-900/8 transition hover:ring-brand-500/40 hover:shadow-lg hover:shadow-ink-900/5">
            <span class="inline-flex size-12 items-center justify-center rounded-xl bg-brand-50 text-accent-500">
              <Icon name={service.icon} class="size-6" />
            </span>
            <h3 class="mt-5 text-lg font-semibold text-ink-900">{service.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-800/80">{service.summary}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-10">
      <Button href="/services/" variant="secondary">
        Découvrir le détail de nos services
        <Icon name="arrow-right" class="size-4" />
      </Button>
    </div>
  </section>

  <CtaBand />

  <!-- A propos -->
  <section class="container-page py-20 sm:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold tracking-widest text-brand-600 uppercase">A propos</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 text-balance sm:text-4xl">
        Une équipe d'experts passionnés du webmarketing
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-800/80">
        Notre équipe est composée d'experts passionnés et expérimentés dans le domaine du
        webmarketing et de la création de site web. Nous sommes fiers de notre savoir-faire et de
        notre capacité à aider les entreprises à atteindre leurs objectifs en ligne.
      </p>
      <Button href="/a-propos/" variant="secondary" class="mt-8">En savoir plus sur nous</Button>
    </div>
  </section>

  <!-- Blog -->
  <section class="bg-brand-50/60 py-20 sm:py-24">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl">Notre actualité</h2>
          <p class="mt-3 text-lg text-ink-800/80">
            Conseils et bonnes pratiques pour votre présence en ligne.
          </p>
        </div>
        <Button href="/blog/" variant="secondary">
          Voir tous les articles
          <Icon name="arrow-right" class="size-4" />
        </Button>
      </div>

      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Contact -->
  <section class="container-page py-20 sm:py-24">
    <div class="rounded-3xl bg-ink-950 px-8 py-14 sm:px-14">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="text-sm font-semibold tracking-widest text-brand-400 uppercase">Contact</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-white text-balance sm:text-4xl">
            Contactez-nous pour en savoir + !
          </h2>
          <p class="mt-4 text-lg text-slate-300">
            Etudions ensemble votre projet : contactez-nous sans tarder, nous vous répondrons sous
            24h !
          </p>
        </div>
        <ul class="space-y-4">
          <li>
            <a
              href={CONTACT.phoneHref}
              class="flex items-center gap-4 rounded-2xl bg-white/5 px-6 py-5 text-white ring-1 ring-white/10 transition hover:bg-white/10"
            >
              <Icon name="phone" class="size-5 text-brand-400" />
              <span class="text-lg font-semibold">{CONTACT.phone}</span>
            </a>
          </li>
          <li>
            <a
              href={CONTACT.emailHref}
              class="flex items-center gap-4 rounded-2xl bg-white/5 px-6 py-5 text-white ring-1 ring-white/10 transition hover:bg-white/10"
            >
              <Icon name="mail" class="size-5 text-brand-400" />
              <span class="text-lg font-semibold break-all">{CONTACT.email}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
