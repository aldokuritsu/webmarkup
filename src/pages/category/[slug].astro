---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  const bySlug = new Map<string, { name: string; posts: CollectionEntry<'blog'>[] }>();
  for (const post of posts) {
    const { category, categorySlug } = post.data;
    if (!category || !categorySlug) continue;
    const bucket = bySlug.get(categorySlug) ?? { name: category, posts: [] };
    bucket.posts.push(post);
    bySlug.set(categorySlug, bucket);
  }

  return [...bySlug].map(([slug, { name, posts: categoryPosts }]) => ({
    params: { slug },
    props: { name, posts: categoryPosts },
  }));
}

interface Props {
  name: string;
  posts: CollectionEntry<'blog'>[];
}

const { name, posts } = Astro.props;
const count = posts.length;
---

<BaseLayout
  title={`${name} — Blog`}
  description={`Tous les articles de Webmark'up dans la catégorie ${name}.`}
>
  <PageHero
    eyebrow="Catégorie"
    title={name}
    lead={`${count} article${count > 1 ? 's' : ''} dans cette catégorie.`}
  />

  <section class="container-page py-20 sm:py-28">
    <ul class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
      {
        posts.map((post, index) => (
          <li>
            <PostCard post={post} loading="eager" tilt={index % 3 === 1} />
          </li>
        ))
      }
    </ul>
    <div class="mt-14">
      <Button href="/blog/" variant="ink">← Retour au blog</Button>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
