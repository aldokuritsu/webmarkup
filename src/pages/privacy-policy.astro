---
import { getEntry, render } from 'astro:content';
import MarkdownPage from '../layouts/MarkdownPage.astro';

const page = await getEntry('pages', 'privacy-policy');
if (!page) throw new Error('Contenu manquant : src/content/pages/privacy-policy.md');
const { Content } = await render(page);
---

<MarkdownPage
  title="Politique de confidentialité"
  description={page.data.description}
  updatedDate={page.data.updatedDate}
  eyebrow="Mentions"
>
  <Content />
</MarkdownPage>
