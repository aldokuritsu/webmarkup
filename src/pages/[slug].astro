---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import Sticker from '../components/Sticker.astro';
import { SITE_TITLE, SITE_URL } from '../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return sorted.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      related: sorted
        .filter(
          (other) =>
            other.id !== post.id &&
            (!post.data.categorySlug || other.data.categorySlug === post.data.categorySlug),
        )
        .concat(sorted.filter((other) => other.id !== post.id))
        .filter((other, index, all) => all.findIndex((o) => o.id === other.id) === index)
        .slice(0, 3),
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  related: CollectionEntry<'blog'>[];
}

const { post, related } = Astro.props;
const { title, description, pubDate, updatedDate, category, categorySlug, heroImage, heroImageAlt } =
  post.data;
const { Content } = await render(post);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  mainEntityOfPage: `${SITE_URL}/${post.id}/`,
  author: { '@type': 'Organization', name: SITE_TITLE, url: SITE_URL },
  publisher: { '@type': 'Organization', name: SITE_TITLE, url: SITE_URL },
  ...(heroImage ? { image: new URL(heroImage.src, SITE_URL).href } : {}),
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate ?? pubDate}
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <article>
    <header class="grain relative overflow-hidden border-b-3 border-ink-950 bg-ink-950">
      <div
        class="pointer-events-none absolute -top-40 right-0 size-[36rem] rounded-full bg-violet-600/35 blur-[130px]"
        aria-hidden="true"
      >
      </div>

      <div class="container-page relative py-20 sm:py-24">
        <nav
          class="flex flex-wrap items-center gap-3 font-display text-sm font-bold tracking-tight text-violet-200/60"
          aria-label="Fil d'Ariane"
        >
          <a class="transition hover:text-spring-400" href="/blog/">Blog</a>
          {
            category && categorySlug && (
              <>
                <span aria-hidden="true">/</span>
                <a class="transition hover:text-spring-400" href={`/category/${categorySlug}/`}>
                  {category}
                </a>
              </>
            )
          }
        </nav>

        <h1
          class="mt-7 max-w-5xl font-display text-[clamp(2.25rem,6vw,5rem)] leading-[0.94] font-extrabold text-white text-balance"
        >
          {title}
        </h1>

        <p class="mt-8 font-display text-sm font-bold tracking-widest text-spring-400 uppercase">
          <FormattedDate date={pubDate} />
          {
            updatedDate && updatedDate.valueOf() !== pubDate.valueOf() && (
              <>
                <span class="text-violet-200/40"> · mis à jour le </span>
                <FormattedDate date={updatedDate} />
              </>
            )
          }
        </p>
      </div>
    </header>

    {
      heroImage && (
        <div class="container-page -mt-12 sm:-mt-16">
          <div class="overflow-hidden rounded-[2rem] border-3 border-ink-950 bg-violet-950 shadow-hard-violet">
            <Image
              src={heroImage}
              alt={heroImageAlt ?? ''}
              widths={[480, 800, 1200, 1600]}
              sizes="(min-width: 1280px) 1200px, 100vw"
              loading="eager"
              class="aspect-16/7 w-full object-cover"
            />
          </div>
        </div>
      )
    }

    <div class="container-page py-16 sm:py-20">
      <div
        class="prose prose-xl prose-slate mx-auto max-w-3xl prose-headings:font-display prose-headings:font-extrabold prose-headings:tracking-tight prose-headings:text-ink-950 prose-h2:mt-14 prose-h2:text-[clamp(1.75rem,3.5vw,2.5rem)] prose-h2:leading-tight prose-p:text-ink-900/80 prose-a:font-semibold prose-a:text-violet-600 prose-a:decoration-2 prose-a:underline-offset-4 hover:prose-a:text-violet-500 prose-strong:text-ink-950 prose-li:text-ink-900/80 prose-li:marker:text-spring-500"
      >
        <Content />
      </div>

      <div class="mx-auto mt-14 max-w-3xl border-t-3 border-ink-950 pt-8">
        <a
          href="/blog/"
          class="inline-flex items-center gap-2 font-display text-lg font-extrabold tracking-tight text-violet-600 transition hover:text-violet-500"
        >
          <span aria-hidden="true">←</span> Tous les articles
        </a>
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="border-t-3 border-ink-950 bg-violet-50 py-20 sm:py-28">
        <div class="container-page">
          <div class="flex flex-wrap items-end justify-between gap-6">
            <div>
              <Sticker tone="violet">À lire aussi</Sticker>
              <h2 class="mt-5 font-display text-[clamp(2rem,5vw,3.5rem)] leading-[0.95] font-extrabold text-ink-950">
                Dans la même veine
              </h2>
            </div>
            <a
              href="/blog/"
              class="inline-flex items-center gap-2 font-display font-extrabold tracking-tight text-violet-600 transition hover:text-violet-500"
            >
              Tous les articles
              <Icon name="arrow-right" class="size-4" />
            </a>
          </div>
          <ul class="mt-12 grid gap-8 md:grid-cols-3">
            {related.map((item, index) => (
              <li>
                <PostCard post={item} tilt={index % 2 === 1} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>
