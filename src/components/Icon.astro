---
/** Petit jeu d'icônes en SVG inline (remplace le FontAwesome de l'ancien thème). */
import type { IconName } from '../data/services';

interface Props {
  name: IconName | 'phone' | 'mail' | 'arrow-right' | 'menu' | 'close' | 'rss';
  class?: string;
}

const { name, class: className = 'size-6' } = Astro.props;

