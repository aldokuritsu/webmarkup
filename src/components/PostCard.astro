---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  loading?: 'eager' | 'lazy';
  tilt?: boolean;
}

const { post, loading = 'lazy', tilt = false } = Astro.props;
const { title, description, pubDate, category, categorySlug, heroImage, heroImageAlt } = post.data;
---

<article
  class:list={[
    'group flex h-full flex-col overflow-hidden rounded-3xl border-3 border-ink-950 bg-white transition duration-200 hover:-translate-y-1.5 hover:shadow-hard',
    tilt && 'sm:-rotate-1 sm:hover:rotate-0',
  ]}
>
  <a
    href={`/${post.id}/`}
    class="duotone block overflow-hidden border-b-3 border-ink-950 bg-violet-950"
    tabindex="-1"
    aria-hidden="true"
  >
    {
      heroImage && (
        <Image
          src={heroImage}
          alt=""
          width={720}
          height={420}
          loading={loading}
          class="aspect-16/9 w-full object-cover transition duration-500 group-hover:scale-105"
        />
      )
    }
  </a>

  <div class="flex flex-1 flex-col p-7">
    {
      category && categorySlug && (
        <a
          href={`/category/${categorySlug}/`}
          class="self-start rounded-full border-2 border-ink-950 bg-spring-300 px-3 py-1 font-display text-xs font-extrabold tracking-wide uppercase transition hover:bg-spring-400"
        >
          {category}
        </a>
      )
    }
    <h3 class="mt-4 font-display text-2xl leading-[1.1] font-extrabold text-balance text-ink-950">
      <a href={`/${post.id}/`} class="transition group-hover:text-violet-600">
        {title}
      </a>
    </h3>
    <p class="mt-4 flex-1 leading-relaxed text-ink-900/70">{description}</p>
    <FormattedDate
      date={pubDate}
      class="mt-6 font-display text-xs font-bold tracking-widest text-ink-900/50 uppercase"
    />
    <span class="sr-only">{heroImageAlt}</span>
  </div>
</article>
