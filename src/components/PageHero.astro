---
import Sticker from './Sticker.astro';

interface Props {
  title: string;
  lead?: string;
  eyebrow?: string;
  /** Mot(s) du titre à souligner en vert. */
  highlight?: string;
}

const { title, lead, eyebrow, highlight } = Astro.props;

const [before, after] = highlight && title.includes(highlight)
  ? [title.slice(0, title.indexOf(highlight)), title.slice(title.indexOf(highlight) + highlight.length)]
  : [title, ''];
---

<section class="grain relative overflow-hidden border-b-3 border-ink-950 bg-ink-950">
  <div
    class="pointer-events-none absolute -top-40 -right-32 size-[38rem] rounded-full bg-violet-600/35 blur-[110px]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-52 left-1/4 size-[30rem] rounded-full bg-spring-500/20 blur-[120px]"
    aria-hidden="true"
  >
  </div>

  <div class="container-page relative py-20 sm:py-28">
    {eyebrow && <Sticker>{eyebrow}</Sticker>}
    <h1
      class="mt-6 max-w-5xl font-display text-[clamp(2.5rem,7vw,5.5rem)] leading-[0.92] font-extrabold text-white text-balance"
    >
      {before}{highlight && <span class="text-spring-400">{highlight}</span>}{after}
    </h1>
    {
      lead && (
        <p class="mt-8 max-w-2xl text-xl leading-relaxed text-violet-100/75">{lead}</p>
      )
    }
  </div>
</section>
