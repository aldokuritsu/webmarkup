---
interface Props {
  title: string;
  lead?: string;
  eyebrow?: string;
}
const { title, lead, eyebrow } = Astro.props;
---

<section class="bg-linear-to-br from-ink-950 via-ink-900 to-brand-900">
  <div class="container-page py-16 sm:py-20">
    {
      eyebrow && (
        <p class="text-sm font-semibold tracking-widest text-brand-400 uppercase">{eyebrow}</p>
      )
    }
    <h1 class="mt-3 max-w-3xl text-3xl font-bold tracking-tight text-white text-balance sm:text-4xl lg:text-5xl">
      {title}
    </h1>
    {lead && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-300">{lead}</p>}
  </div>
</section>
