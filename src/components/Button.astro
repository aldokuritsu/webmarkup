---
interface Props {
  href: string;
  variant?: 'primary' | 'spring' | 'ink' | 'outline';
  size?: 'md' | 'lg';
  class?: string;
}

const { href, variant = 'primary', size = 'md', class: className = '' } = Astro.props;

const base =
  'group/btn inline-flex items-center justify-center gap-2.5 rounded-full font-display font-bold tracking-tight transition-transform duration-150 active:translate-y-0.5';
const sizes = {
  md: 'px-6 py-3 text-[0.95rem]',
  lg: 'px-8 py-4 text-lg',
};
const variants = {
  primary: 'bg-violet-600 text-white hover:bg-violet-500',
  spring: 'bg-spring-400 text-ink-950 hover:bg-spring-300',
  ink: 'bg-ink-950 text-white hover:bg-ink-900',
  outline: 'text-white ring-2 ring-white/35 hover:ring-spring-400 hover:text-spring-300',
};
---

<a href={href} class:list={[base, sizes[size], variants[variant], className]}>
  <slot />
</a>
