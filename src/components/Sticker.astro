---
/** Pastille inclinée, façon autocollant. */
interface Props {
  tone?: 'spring' | 'violet' | 'ink';
  class?: string;
}
const { tone = 'spring', class: className = '' } = Astro.props;

const tones = {
  spring: 'bg-spring-400 text-ink-950',
  violet: 'bg-violet-600 text-white',
  ink: 'bg-ink-950 text-spring-400',
};
---

<span
  class:list={[
    'inline-block -rotate-3 rounded-full px-4 py-1.5 font-display text-sm font-extrabold tracking-tight uppercase',
    tones[tone],
    className,
  ]}
>
  <slot />
</span>
