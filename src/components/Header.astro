---
import { NAV } from '../consts';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-ink-900/5 bg-white/85 backdrop-blur">
  <div class="container-page flex h-18 items-center justify-between gap-4 py-3">
    <a href="/" class="rounded-lg" aria-label="Webmark'up — accueil">
      <Logo />
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Navigation principale">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-full px-3.5 py-2 text-sm font-medium transition',
              isActive(item.href)
                ? 'bg-brand-50 text-brand-700'
                : 'text-ink-800 hover:bg-ink-900/5 hover:text-ink-900',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/nous-contacter/"
        class="ml-2 inline-flex items-center gap-2 rounded-full bg-brand-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-600"
      >
        Étudier mon projet
      </a>
    </nav>

    <button
      type="button"
      id="nav-toggle"
      class="inline-flex items-center justify-center rounded-lg p-2 text-ink-900 hover:bg-ink-900/5 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="sr-only">Ouvrir le menu</span>
      <Icon name="menu" class="size-6" />
    </button>
  </div>

  <div id="mobile-nav" class="border-t border-ink-900/5 bg-white md:hidden" hidden>
    <nav class="container-page flex flex-col py-3" aria-label="Navigation mobile">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3 py-3 text-base font-medium',
              isActive(item.href) ? 'text-brand-700' : 'text-ink-800',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });
</script>
