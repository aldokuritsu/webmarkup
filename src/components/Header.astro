---
import { NAV } from '../consts';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<header class="sticky top-0 z-50 border-b-3 border-ink-950 bg-cream/95 backdrop-blur">
  <div class="container-page flex h-20 items-center justify-between gap-4">
    <a href="/" class="rounded-xl" aria-label="Webmark'up — accueil">
      <Logo />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navigation principale">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'relative rounded-full px-4 py-2 font-display text-[0.95rem] font-bold tracking-tight transition',
              isActive(item.href)
                ? 'bg-ink-950 text-spring-400'
                : 'text-ink-900 hover:bg-violet-100',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/nous-contacter/"
        class="ml-3 inline-flex items-center gap-2 rounded-full border-3 border-ink-950 bg-spring-400 px-5 py-2.5 font-display font-extrabold tracking-tight text-ink-950 transition hover:-translate-y-0.5 hover:shadow-[4px_4px_0_0_var(--color-ink-950)]"
      >
        Parlons-en
        <Icon name="arrow-right" class="size-4" />
      </a>
    </nav>

    <button
      type="button"
      id="nav-toggle"
      class="inline-flex items-center justify-center rounded-xl border-3 border-ink-950 p-2 text-ink-950 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="sr-only">Ouvrir le menu</span>
      <Icon name="menu" class="size-6" />
    </button>
  </div>

  <div id="mobile-nav" class="border-t-3 border-ink-950 bg-cream lg:hidden" hidden>
    <nav class="container-page flex flex-col py-4" aria-label="Navigation mobile">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'border-b border-ink-950/10 py-4 font-display text-xl font-extrabold tracking-tight',
              isActive(item.href) ? 'text-violet-600' : 'text-ink-950',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/nous-contacter/"
        class="mt-5 inline-flex items-center justify-center gap-2 rounded-full border-3 border-ink-950 bg-spring-400 px-5 py-3 font-display font-extrabold tracking-tight text-ink-950"
      >
        Parlons-en
        <Icon name="arrow-right" class="size-4" />
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });
</script>
