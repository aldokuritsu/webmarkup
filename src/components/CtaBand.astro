---
import Button from './Button.astro';
import Icon from './Icon.astro';

interface Props {
  title?: string;
  text?: string;
  cta?: string;
}

const {
  title = 'Ne perdez plus de temps à vous soucier de votre présence en ligne',
  text = "Faites confiance à notre équipe d'experts en webmarketing pour vous aider à atteindre vos objectifs en ligne. Demandez une étude dès maintenant, c'est gratuit et sans engagement !",
  cta = 'Étudions votre projet',
} = Astro.props;
---

<section class="border-y-3 border-ink-950 bg-spring-400">
  <div class="container-page grid gap-10 py-20 lg:grid-cols-12 lg:items-center">
    <div class="lg:col-span-8">
      <h2
        class="font-display text-[clamp(2rem,5vw,3.75rem)] leading-[0.95] font-extrabold text-balance text-ink-950"
      >
        {title} <span class="inline-block">!</span>
      </h2>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-950/75">{text}</p>
    </div>
    <div class="lg:col-span-4 lg:justify-self-end">
      <Button href="/nous-contacter/" variant="ink" size="lg" class="border-3 border-ink-950">
        {cta}
        <Icon name="arrow-right" class="size-5 transition group-hover/btn:translate-x-1" />
      </Button>
      <p class="mt-4 font-display text-sm font-bold tracking-tight text-ink-950/60">
        Gratuit et sans engagement — réponse sous 24h.
      </p>
    </div>
  </div>
</section>
