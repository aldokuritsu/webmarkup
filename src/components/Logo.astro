---
/** Signature visuelle : la flèche ascendante du favicon historique + le nom. */
interface Props {
  class?: string;
  variant?: 'dark' | 'light';
}
const { class: className = '', variant = 'dark' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg class="size-9 shrink-0" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <rect width="48" height="48" rx="12" fill="currentColor" class="text-brand-500" />
    <path
      d="M13 34c6.5 0 11-3.6 11-10V17"
      fill="none"
      stroke="#fff"
      stroke-width="4.5"
      stroke-linecap="round"
    ></path>
    <path d="M24 12.5 31.5 21h-15L24 12.5Z" fill="#fff"></path>
  </svg>
  <span
    class:list={[
      'text-xl font-bold tracking-tight',
      variant === 'light' ? 'text-white' : 'text-ink-900',
    ]}
  >
    Webmark<span class="text-brand-500">'</span>up
  </span>
</span>
