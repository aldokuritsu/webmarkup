---
/**
 * Identité : la courbe statistique en flèche montante de la charte historique
 * (barres violettes + courbe verte qui décolle).
 */
interface Props {
  class?: string;
  variant?: 'dark' | 'light';
  markOnly?: boolean;
  markClass?: string;
}

const {
  class: className = '',
  variant = 'dark',
  markOnly = false,
  markClass = 'size-10',
} = Astro.props;
---

{
  markOnly ? (
    <svg class={markClass} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
      <rect x="4" y="31" width="7" height="12" rx="2.5" fill="currentColor" opacity="0.35" />
      <rect x="14" y="25" width="7" height="18" rx="2.5" fill="currentColor" opacity="0.55" />
      <rect x="24" y="19" width="7" height="24" rx="2.5" fill="currentColor" opacity="0.8" />
      <rect x="34" y="11" width="7" height="32" rx="2.5" fill="currentColor" />
    </svg>
  ) : (
    <span class:list={['inline-flex items-center gap-3', className]}>
      <svg class="size-10 shrink-0" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <rect x="4" y="31" width="7" height="12" rx="2.5" fill="#a674ff" />
        <rect x="14" y="25" width="7" height="18" rx="2.5" fill="#8b3dff" />
        <rect x="24" y="19" width="7" height="24" rx="2.5" fill="#7c1fff" />
        <rect x="34" y="11" width="7" height="32" rx="2.5" fill="#6a0fdb" />
        <path
          d="M3 34C11 34 15.5 23.5 23 16.5C28.5 11.4 34.5 7.5 43 5"
          fill="none"
          stroke="#14e894"
          stroke-width="4.2"
          stroke-linecap="round"
        />
        <path
          d="M34.5 4.5H44V14"
          fill="none"
          stroke="#14e894"
          stroke-width="4.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      <span
        class:list={[
          'font-display text-2xl leading-none font-extrabold tracking-tighter',
          variant === 'light' ? 'text-white' : 'text-ink-950',
        ]}
      >
        Webmark<span class="text-spring-500">'</span>up
      </span>
    </span>
  )
}
