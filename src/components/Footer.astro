---
import { CONTACT, NAV, SITE_TAGLINE } from '../consts';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="mt-24 bg-ink-950 text-slate-300">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <Logo variant="light" />
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-slate-400">
        {SITE_TAGLINE}. Agence web basée à {CONTACT.city}, en {CONTACT.region} : création de site
        internet, gestion quotidienne, SEO, SEA et maintenance technique.
      </p>
    </div>

    <div>
      <h2 class="text-sm font-semibold tracking-wide text-white uppercase">Navigation</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          NAV.map((item) => (
            <li>
              <a class="transition hover:text-brand-400" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="transition hover:text-brand-400" href="/privacy-policy/">
            Politique de confidentialité
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold tracking-wide text-white uppercase">Contact</h2>
      <ul class="mt-4 space-y-3 text-sm">
        <li>
          <a class="inline-flex items-center gap-2.5 transition hover:text-brand-400" href={CONTACT.phoneHref}>
            <Icon name="phone" class="size-4 text-brand-500" />
            {CONTACT.phone}
          </a>
        </li>
        <li>
          <a class="inline-flex items-center gap-2.5 transition hover:text-brand-400" href={CONTACT.emailHref}>
            <Icon name="mail" class="size-4 text-brand-500" />
            {CONTACT.email}
          </a>
        </li>
        <li>
          <a class="inline-flex items-center gap-2.5 transition hover:text-brand-400" href="/rss.xml">
            <Icon name="rss" class="size-4 text-brand-500" />
            Flux RSS
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <p class="container-page py-6 text-center text-xs text-slate-500">
      &copy; {year} Webmark'up — Tous droits réservés
    </p>
  </div>
</footer>
